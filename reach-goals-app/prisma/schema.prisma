generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("REACHGOALS_URL")
  directUrl = env("REACHGOALS_URL_NON_POOLING")
}

model Goal {
  id          String          @id @default(uuid())
  name        String
  description String?
  order       Int?
  create      DateTime     @default(now())
  start       DateTime     @default(now())
  end         DateTime?
  status      String?
  assignments Assignment[]
  tags        TagOnGoal[]
  visitorId   String
  visitor     DemoVisitor @relation(fields: [visitorId], references: [id])
}

model Assignment {
  id          String               @id @default(uuid())
  name        String
  description String?
  duration    Int?
  order       Int?
  create      DateTime          @default(now())
  end         DateTime?
  start       DateTime          @default(now())
  status      String?
  visitorId   String
  visitor     DemoVisitor @relation(fields: [visitorId], references: [id])
  goalID      String?
  goal        Goal?             @relation(fields: [goalID], references: [id])
  tags        TagOnAssignment[]
}

model Tag {
  id          String               @id @default(uuid())
  name        String
  color       String
  assignments TagOnAssignment[]
  goals       TagOnGoal[]
  visitorId   String
  visitor     DemoVisitor @relation(fields: [visitorId], references: [id])
}

model TagOnGoal {
  id     String  @id @default(uuid())
  goalID String
  tagID  String
  goal   Goal @relation(fields: [goalID], references: [id])
  tag    Tag  @relation(fields: [tagID], references: [id], onDelete: Cascade)

  @@unique([goalID, tagID])
}

model TagOnAssignment {
  id           String        @id @default(uuid())
  assignmentID String
  tagID        String
  assignment   Assignment @relation(fields: [assignmentID], references: [id])
  tag          Tag        @relation(fields: [tagID], references: [id], onDelete: Cascade)

  @@unique([assignmentID, tagID])
}

model DemoVisitor {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  createdAt          DateTime             @default(now())
  DemoVisitorSession DemoVisitorSession[]
  goals              Goal[]
  assignments        Assignment[]
  tags               Tag[]
}

model DemoVisitorSession {
  id            String                   @id @default(uuid())
  demoVisitorId String                   @unique
  demoVisitor   DemoVisitor              @relation(fields: [demoVisitorId], references: [id])
  status        DemoVisitorSessionStatus
  expiresAt     DateTime
  createdAt     DateTime                 @default(now())
}

model DemoVisitorVerification {
  id        String      @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  updatedAt DateTime?
  createdAt DateTime @default(now())
}

enum DemoVisitorSessionStatus {
  ACTIVE
  EXPIRED
}
