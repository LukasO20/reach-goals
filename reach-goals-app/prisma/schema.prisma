generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("REACHGOALS_URL")
  directUrl = env("REACHGOALS_URL_NON_POOLING")
}

model Goal {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  order       Int?
  create      DateTime     @default(now())
  start       DateTime     @default(now())
  end         DateTime?
  status      String?
  assignments Assignment[]
  tags        TagOnGoal[]
}

model Assignment {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  duration    Int?
  order       Int?
  create      DateTime          @default(now())
  end         DateTime?
  start       DateTime          @default(now())
  status      String?
  goalID      Int?
  goal        Goal?             @relation(fields: [goalID], references: [id])
  tags        TagOnAssignment[]
}

model Tag {
  id          Int               @id @default(autoincrement())
  name        String
  color       String
  assignments TagOnAssignment[]
  goals       TagOnGoal[]
}

model TagOnGoal {
  id     Int  @id @default(autoincrement())
  goalID Int
  tagID  Int
  goal   Goal @relation(fields: [goalID], references: [id])
  tag    Tag  @relation(fields: [tagID], references: [id], onDelete: Cascade)

  @@unique([goalID, tagID])
}

model TagOnAssignment {
  id           Int        @id @default(autoincrement())
  assignmentID Int
  tagID        Int
  assignment   Assignment @relation(fields: [assignmentID], references: [id])
  tag          Tag        @relation(fields: [tagID], references: [id], onDelete: Cascade)

  @@unique([assignmentID, tagID])
}

model DemoVisitor {
  id                 Int                  @id @default(autoincrement())
  name               String
  email              String               @unique
  createdAt          DateTime             @default(now())
  DemoVisitorSession DemoVisitorSession[]
}

model DemoVisitorSession {
  id            Int                      @id @default(autoincrement())
  demoVisitorId Int
  demoVisitor   DemoVisitor              @relation(fields: [demoVisitorId], references: [id])
  status        DemoVisitorSessionStatus
  expiresAt     DateTime
  createdAt     DateTime                 @default(now())
}

model DemoVisitorValidation {
  email String @id
  code String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum DemoVisitorSessionStatus {
  ACTIVE
  EXPIRED
}
